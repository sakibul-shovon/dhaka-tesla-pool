# Copy to .env and fill in for local (non-Docker) development.
# Docker Compose supplies its own values for db<->api wiring — see docker-compose.yml.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Auth (plan §13.3)
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# postgres://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgres://dtp:dtp@localhost:5432/dtp
# Kept small for free-tier Postgres (Neon), which is metered by CU-hours (plan §18.3).
DB_POOL_MAX=5

POSTGRES_USER=dtp
POSTGRES_PASSWORD=dtp
POSTGRES_DB=dtp

# Demo/seed data (Jashim, Bullet, Nusrat, Rafiq, Shirin) — never a real password.
SEED_DEMO=true
ALLOW_DEMO_SEED=true
DEMO_PASSWORD=dhaka-tesla-demo
