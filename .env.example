# Copy to .env and fill in for local (non-Docker) development.
# Docker Compose supplies its own values for db<->api wiring — see docker-compose.yml.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# postgres://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgres://dtp:dtp@localhost:5432/dtp

POSTGRES_USER=dtp
POSTGRES_PASSWORD=dtp
POSTGRES_DB=dtp
