{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config:*)",
      "Bash(git filter-branch:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Read(**/.env)",
      "Edit(.githooks/**)",
      "Edit(scripts/git/**)",
      "Edit(.claude/**)",
      "Edit(.github/workflows/git-policy.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"" }]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"" }]
      }
    ]
  }
}
